{
  "name": "society-gate",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "dev:secrets": "bash scripts/dev-secrets.sh",
    "gen:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-queries.mjs"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
