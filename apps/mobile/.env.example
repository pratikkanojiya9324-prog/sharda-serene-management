# Copy to .env. A physical phone cannot reach "localhost" on your PC:
# use the PC's LAN IP instead (e.g. http://192.168.1.20:54321) and the same Wi-Fi network.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>
# Optional: the admin website address, shown to admin-only users on the "No access" screen.
EXPO_PUBLIC_ADMIN_URL=
