{
  "expo": {
    "name": "Society Gate",
    "slug": "pratik",
    "owner": "pratik9324s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "societygate",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.societygate.app"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "cameraPermission": "Allow Society Gate to take photos of visitors." }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      ["expo-notifications", { "color": "#208AEF", "icon": "./assets/images/android-icon-monochrome.png" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
